# Web UI Admin credentials — CHANGE BEFORE STARTING
# The server refuses to start if ADMIN_PASS is left as "changeme".
ADMIN_USER=admin
ADMIN_PASS=changeme

# Long random string — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_random_secret_at_least_32_chars

# ADDITIONAL numbers you own, comma-separated, E.164 (a leading + and country
# code). The linked WhatsApp account is detected automatically; only list other
# handsets you want `personal:send` keys to reach without the allow list.
# Drop the leading 0 and prefix your country code:
#   Pakistan   03XX-XXXXXXX  ->  +92 3XX XXXXXXX
#   UAE        05X-XXXXXXX   ->  +971 5X XXXXXXX
PERSONAL_NUMBERS=

# Public URL the UI/CLI is reached at. Used for CLI config and QR-callback links.
# Examples:
#   http://localhost:3900                       (local dev, default port)
#   https://wpp.example.com                     (host nginx with TLS)
#   https://your-host.tail-xxxx.ts.net          (Tailscale Serve)
PUBLIC_URL=http://localhost:3900

# Set to 1 when PUBLIC_URL is HTTPS (sets Secure flag on session cookies).
# Auto-detected from PUBLIC_URL if unset.
COOKIE_SECURE=

# Where the docker-compose nginx binds. Default 127.0.0.1 keeps the UI off your
# LAN; set to 0.0.0.0 only if you fully trust your network OR no external
# reverse proxy / Tailscale is fronting this stack.
BIND_HOST=127.0.0.1

# Keep a copy of media as it arrives.
#
# WhatsApp removes media from its CDN after a while. With this off, media is
# fetched only when something asks for it — and by then the bytes are often
# gone, leaving only a re-upload request to the phone, which it often ignores.
# Turn this on if the media in your chats matters; expect the disk under
# data/media to grow.
MEDIA_AUTO_DOWNLOAD=0
# Skip anything larger than this (MB). 0 disables the limit.
MEDIA_AUTO_DOWNLOAD_MAX_MB=25

# Rate limiting (requests per minute per IP) — generous defaults for personal use
# Set to 0 to disable
RATE_LIMIT_LOGIN=10
RATE_LIMIT_SEND=60

# Auto-reply caps (docs/autoreply.md). A rule set can be stricter, never looser.
# Auto-reply itself is switched on in the console and is off by default.
# AUTOREPLY_MIN_GAP_S=60
# AUTOREPLY_MAX_PER_CHAT_PER_HOUR=3
# AUTOREPLY_MAX_PER_CHAT_PER_DAY=10
# AUTOREPLY_MAX_PER_HOUR=30
# AUTOREPLY_MAX_AGE_S=180

# Model gateway for auto-reply rules with "type": "llm" (OpenAI-compatible,
# base URL ending in /v1). Without it those rules send their fallback_text.
# LLM_GATEWAY_URL=https://llm.example.com/v1
# LLM_GATEWAY_API_KEY=
# LLM_GATEWAY_TIMEOUT_S=15
