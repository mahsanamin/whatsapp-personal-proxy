# Web UI Admin credentials — CHANGE BEFORE STARTING
# The server refuses to start if ADMIN_PASS is left as "changeme".
ADMIN_USER=admin
ADMIN_PASS=changeme

# Long random string — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_random_secret_at_least_32_chars

# YOUR OWN numbers, comma-separated, E.164 (a leading + and country code).
# These bypass the allow list, so an API key can always reach you.
# Leave this unset and `personal:send` will refuse every number you own. Do not
# put a plausible-looking example here: the previous default was a reserved
# fiction number that read like a real one and quietly stayed unedited.
# Drop the leading 0 and prefix your country code:
#   Pakistan   03XX-XXXXXXX  ->  +92 3XX XXXXXXX
#   UAE        05X-XXXXXXX   ->  +971 5X XXXXXXX
PERSONAL_NUMBERS=CHANGE_ME_TO_YOUR_E164_NUMBER

# Public URL the UI/CLI is reached at. Used for CLI config and QR-callback links.
# Examples:
#   http://localhost:3300                       (local dev, default port)
#   https://wpp.example.com                     (host nginx with TLS)
#   https://your-host.tail-xxxx.ts.net          (Tailscale Serve)
PUBLIC_URL=http://localhost:3300

# Set to 1 when PUBLIC_URL is HTTPS (sets Secure flag on session cookies).
# Auto-detected from PUBLIC_URL if unset.
COOKIE_SECURE=

# Where the docker-compose nginx binds. Default 127.0.0.1 keeps the UI off your
# LAN; set to 0.0.0.0 only if you fully trust your network OR no external
# reverse proxy / Tailscale is fronting this stack.
BIND_HOST=127.0.0.1

# Rate limiting (requests per minute per IP) — generous defaults for personal use
# Set to 0 to disable
RATE_LIMIT_LOGIN=10
RATE_LIMIT_SEND=60
