    p.add_argument("--up-to", help="ISO timestamp; mark read only up to here")

    p = sub.add_parser("chats", help="List chats (DMs, groups, channels)")
    p.add_argument("--type", choices=("all", "dm", "group", "channel"), default="all")
    p.add_argument("--search", help="Filter by name or JID")
    p.add_argument("--count", type=bounded_int(1, 1000), default=50)
    p.add_argument("--no-archived", action="store_true", help="Hide archived chats")
    p.add_argument("--verbose", action="store_true", help="Full records instead of the compact shape")

    p = sub.add_parser("groups", help="List groups")
