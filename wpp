    p = sub.add_parser("resolve", help="Show the JID a number or name resolves to")
    p.add_argument("target")
    p.add_argument("--type", choices=("dm", "group", "channel"))

    p = sub.add_parser("history", help="Read messages from a DM or group")
    p.add_argument("target", help="Number, JID, or chat name")
    p.add_argument("--count", type=bounded_int(1, 200), default=50)
    p.add_argument("--after", help="ISO timestamp; only messages newer than this")
