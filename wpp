#!/usr/bin/env python3
"""Agent-friendly CLI for WhatsApp Personal Proxy. Requires Python 3.9+ only."""

import argparse
import getpass
import json
import os
import re
import shutil
import ssl
import stat
import sys
import tempfile
from pathlib import Path
from urllib import error, parse, request

VERSION = "1.0.0"
DEFAULT_CONFIG = Path(os.environ.get("WPP_CONFIG", "~/.config/wpp/config.json")).expanduser()

GROUP_SUFFIX = "@g.us"
PN_SUFFIX = "@s.whatsapp.net"


class WppError(Exception):
    def __init__(self, message, code="WPP_ERROR", status=None, details=None):
        super().__init__(message)
        self.code = code
        self.status = status
        self.details = details


def emit(value, pretty=False, stream=sys.stdout):
    json.dump(value, stream, indent=2 if pretty else None, separators=None if pretty else (",", ":"))
    stream.write("\n")
    stream.flush()


def fail(message, code="WPP_ERROR", status=None, details=None, pretty=False):
    payload = {"success": False, "error": {"code": code, "message": str(message)}}
    if status is not None:
        payload["error"]["status"] = status
    if details:
        payload["error"]["details"] = details
    emit(payload, pretty=pretty, stream=sys.stderr)


def ok(data, meta=None):
    payload = {"success": True, "data": data}
    if meta:
        payload["meta"] = meta
    return payload


# ─── Local config ──────────────────────────────────────────────────────────


def load_config(required=False):
    if not DEFAULT_CONFIG.exists():
        if required:
            raise WppError(
                "No connection configured. Run: wpp connect http://SERVER:3300",
                "NOT_CONNECTED",
            )
        return {"version": 1, "current": None, "profiles": {}}
    try:
        data = json.loads(DEFAULT_CONFIG.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise WppError("Could not read config: %s" % exc, "BAD_CONFIG")
    if not isinstance(data.get("profiles"), dict):
        raise WppError("Config has an invalid profiles object", "BAD_CONFIG")
    return data


def save_config(data):
    DEFAULT_CONFIG.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, tmp_name = tempfile.mkstemp(prefix=".config-", dir=str(DEFAULT_CONFIG.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2)
            handle.write("\n")
        os.chmod(tmp_name, 0o600)
        os.replace(tmp_name, DEFAULT_CONFIG)
        os.chmod(DEFAULT_CONFIG, 0o600)
    finally:
        if os.path.exists(tmp_name):
            os.unlink(tmp_name)


def normalize_url(value):
    value = value.strip().rstrip("/")
    parsed = parse.urlparse(value)
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        raise WppError("Server URL must start with http:// or https://", "BAD_URL")
    if parsed.path not in ("", "/") or parsed.params or parsed.query or parsed.fragment:
        raise WppError("Server URL must not include a path, query, or fragment", "BAD_URL")
    return value


def selected_profile(args, required=True):
    config = load_config(required=required)
    name = getattr(args, "profile", None) or os.environ.get("WPP_PROFILE") or config.get("current")
    profile = config.get("profiles", {}).get(name) if name else None
    if required and not profile:
        raise WppError(
            "Profile is not configured. Run wpp profiles, or wpp connect URL --name NAME",
            "PROFILE_NOT_FOUND",
        )
    return config, name, profile


# ─── HTTP ──────────────────────────────────────────────────────────────────


def build_request(profile, method, path, params=None, body=None, auth=True, accept="application/json"):
    if not path.startswith("/"):
        path = "/" + path
    url = profile["url"] + path
    if params:
        cleaned = {key: value for key, value in params.items() if value is not None}
        if cleaned:
            url += "?" + parse.urlencode(cleaned)
    headers = {"Accept": accept, "User-Agent": "wpp/%s" % VERSION}
    if auth:
        key = profile.get("key")
        if not key:
            raise WppError("Profile has no API token; reconnect it", "MISSING_TOKEN")
        headers["Authorization"] = "Bearer %s" % key
    payload = None
    if body is not None:
        payload = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    req = request.Request(url, data=payload, headers=headers, method=method.upper())
    context = None
    if profile.get("insecure") and url.startswith("https://"):
        context = ssl._create_unverified_context()
    return req, context, url


def api_call(profile, method, path, params=None, body=None, auth=True):
    req, context, url = build_request(profile, method, path, params, body, auth)
    try:
        with request.urlopen(req, timeout=profile.get("timeout", 30), context=context) as response:
            raw = response.read().decode("utf-8")
            return json.loads(raw) if raw else {"ok": True}
    except error.HTTPError as exc:
        raw = exc.read().decode("utf-8", errors="replace")
        try:
            server = json.loads(raw)
            message = server.get("error") or "Server returned HTTP %s" % exc.code
            code = server.get("code") or "HTTP_ERROR"
            details = None
        except ValueError:
            message, code, details = "Server returned HTTP %s" % exc.code, "HTTP_ERROR", {"body": raw[:500]}
        raise WppError(message, code, status=exc.code, details=details)
    except error.URLError as exc:
        raise WppError("Could not reach %s: %s" % (profile["url"], exc.reason), "CONNECTION_FAILED")
    except (ValueError, TimeoutError) as exc:
        raise WppError("Invalid response from server: %s" % exc, "BAD_RESPONSE")


def bool_text(value):
    return "true" if value else "false"


def compact_message(m):
    """Trim a message to what a reader actually needs.

    The stored row carries media keys, sha256s, mime types and internal ids.
    An LLM pays for every one of those tokens and can act on none of them, so
    the default shape is lean and --verbose returns the row untouched.
    """
    out = {
        "at": m.get("timestamp"),
        "from": ("you" if m.get("is_from_me") else (m.get("from_name") or (m.get("from_jid") or "").split("@")[0])),
        "text": m.get("body") or "",
    }
    if m.get("type") and m["type"] != "text":
        out["type"] = m["type"]
        if not out["text"]:
            out["text"] = "[%s]" % m["type"]
    if m.get("mentions_me"):
        out["mentions_you"] = True
    if m.get("quoted_id"):
        out["reply_to"] = m["quoted_id"]
    if m.get("reactions"):
        out["reactions"] = [r.get("emoji") for r in m["reactions"]]
    if m.get("media_saved"):
        out["media_saved"] = True
    if m.get("id"):
        out["id"] = m["id"]
    return out


def compact_chat(c):
    out = {
        "jid": c.get("jid"),
        "name": c.get("display_name") or (c.get("jid") or "").split("@")[0],
        "type": c.get("type"),
    }
    if c.get("unread_count"):
        out["unread"] = c["unread_count"]
    if c.get("unread_mentions"):
        out["mentions_you"] = c["unread_mentions"]
    last = c.get("last_message")
    if last:
        out["last"] = {"at": last.get("timestamp"), "text": last.get("body") or ("[%s]" % last.get("type"))}
    if c.get("is_muted"):
        out["muted"] = True
    return out


def require_confirmation(args, action):
    if getattr(args, "yes", False):
        return
    if not sys.stdin.isatty():
        raise WppError("%s requires --yes in non-interactive use" % action, "CONFIRMATION_REQUIRED")
    answer = input("%s [y/N]: " % action).strip().lower()
    if answer not in ("y", "yes"):
        raise WppError("Cancelled", "CANCELLED")


# ─── Target resolution ─────────────────────────────────────────────────────


def phone_to_jid(value):
    digits = re.sub(r"[\s()\-]", "", value).lstrip("+")
    if re.fullmatch(r"\d{5,20}", digits):
        return digits + PN_SUFFIX
    return None


def resolve_target(profile, target, kind=None):
    """Turn '+971...', a raw JID, or a chat name into a JID.

    Name lookup asks the server, so it needs a token with channels:read.
    Numbers and JIDs resolve locally with no network call.
    """
    target = target.strip()
    if not target:
        raise WppError("Target cannot be empty", "BAD_ARGUMENT")

    if "@" in target:
        return {"jid": target, "display_name": None, "matched_by": "jid"}

    as_phone = phone_to_jid(target)
    if as_phone:
        return {"jid": as_phone, "display_name": None, "matched_by": "number"}

    params = {"search": target}
    if kind:
        params["type"] = kind
    matches = api_call(profile, "GET", "/api/channels", params)
    if not isinstance(matches, list):
        raise WppError("Unexpected response while resolving %r" % target, "BAD_RESPONSE")

    if not matches:
        raise WppError(
            "No chat matches %r. Try `wpp chats --search %s`, or pass a number or JID."
            % (target, parse.quote(target)),
            "TARGET_NOT_FOUND",
        )

    exact = [m for m in matches if (m.get("display_name") or "").lower() == target.lower()]
    candidates = exact or matches

    if len(candidates) > 1:
        raise WppError(
            "%r matches %d chats; be more specific or pass the JID" % (target, len(candidates)),
            "AMBIGUOUS_TARGET",
            details={"candidates": [
                {"jid": m["jid"], "display_name": m.get("display_name"), "type": m.get("type")}
                for m in candidates[:10]
            ]},
        )

    match = candidates[0]
    return {"jid": match["jid"], "display_name": match.get("display_name"), "matched_by": "name"}


# ─── Connection commands ───────────────────────────────────────────────────


def cmd_connect(args):
    url = normalize_url(args.url)
    if args.token_stdin:
        key = sys.stdin.readline().strip()
    else:
        key = os.environ.get("WPP_TOKEN") or getpass.getpass("API token (input hidden): ").strip()
    if not key:
        raise WppError("API token cannot be empty", "MISSING_TOKEN")

    profile = {"url": url, "key": key, "insecure": bool(args.insecure), "timeout": args.timeout}
    auth = api_call(profile, "GET", "/api/auth/test")
    if auth.get("personal_numbers"):
        profile["personal_numbers"] = auth["personal_numbers"]

    config = load_config()
    config.setdefault("profiles", {})[args.name] = profile
    config["current"] = args.name
    save_config(config)

    return ok({
        "connected": True,
        "profile": args.name,
        "url": url,
        "config": str(DEFAULT_CONFIG),
        "scopes": auth.get("auth", {}).get("scopes", []),
        "whatsapp": auth.get("wa", {}),
    })


def cmd_profiles(args):
    config = load_config()
    rows = []
    for name, profile in sorted(config.get("profiles", {}).items()):
        key = profile.get("key", "")
        rows.append({
            "name": name,
            "current": name == config.get("current"),
            "url": profile.get("url"),
            "token": (key[:11] + "…") if key else None,
            "insecure": bool(profile.get("insecure")),
        })
    return ok({"profiles": rows, "config": str(DEFAULT_CONFIG)})


def cmd_use(args):
    config = load_config(required=True)
    if args.name not in config.get("profiles", {}):
        raise WppError("Unknown profile: %s" % args.name, "PROFILE_NOT_FOUND")
    config["current"] = args.name
    save_config(config)
    return ok({"current": args.name})


def cmd_disconnect(args):
    config, name, _profile = selected_profile(args)
    config["profiles"].pop(name, None)
    if config.get("current") == name:
        config["current"] = next(iter(config["profiles"]), None)
    save_config(config)
    return ok({"removed": name, "current": config.get("current")})


def cmd_status(args):
    config, name, profile = selected_profile(args)
    auth = api_call(profile, "GET", "/api/auth/test")

    # Refresh the cached personal numbers while we are here
    if auth.get("personal_numbers") is not None:
        profile["personal_numbers"] = auth["personal_numbers"]
        config["profiles"][name] = profile
        save_config(config)

    wa = auth.get("wa", {})
    data = {
        "profile": name,
        "url": profile["url"],
        "auth": auth.get("auth", {}),
        "whatsapp": wa,
        "server": auth.get("server", {}),
    }
    console = auth.get("server", {}).get("public_url") or profile["url"]
    if not wa.get("linked"):
        data["next"] = "No WhatsApp account is linked. Open %s and scan the QR code." % console
    elif wa.get("status") != "open":
        data["next"] = "WhatsApp is linked but not connected right now (status: %s)." % wa.get("status")
    return ok(data)


def cmd_install(args):
    source = Path(__file__).resolve()
    target = Path(args.path).expanduser()
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists() and not args.force and target.resolve() != source:
        raise WppError("Target exists; use --force to replace it: %s" % target, "TARGET_EXISTS")
    if target.resolve() != source:
        fd, tmp_name = tempfile.mkstemp(prefix=".wpp-", dir=str(target.parent))
        os.close(fd)
        try:
            shutil.copyfile(source, tmp_name)
            os.chmod(tmp_name, 0o755)
            os.replace(tmp_name, target)
        finally:
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)
    else:
        os.chmod(target, os.stat(target).st_mode | stat.S_IXUSR)
    return ok({
        "installed": str(target),
        "on_path": str(target.parent) in os.environ.get("PATH", "").split(os.pathsep),
    })


# ─── Sending ───────────────────────────────────────────────────────────────


def is_personal(profile, jid):
    numbers = profile.get("personal_numbers") or []
    digits = jid.split("@")[0]
    return any(re.sub(r"\D", "", n) == digits for n in numbers)


def do_send(args, profile):
    text = args.text
    if args.text_stdin or text is None:
        text = sys.stdin.read().rstrip("\n")
    if not text:
        raise WppError("Message text cannot be empty", "BAD_ARGUMENT")

    resolved = resolve_target(profile, args.target)
    jid = resolved["jid"]
    label = resolved["display_name"] or jid

    route = args.route
    if route == "auto":
        if jid.endswith(GROUP_SUFFIX):
            route = "group"
        elif is_personal(profile, jid):
            route = "personal"
        else:
            route = "others"

    require_confirmation(args, "Send message to %s (%s)?" % (label, route))

    def send_via(which):
        if which == "group":
            return api_call(profile, "POST", "/api/groups/send", body={"jid": jid, "message": text})
        number = "+" + jid.split("@")[0]
        path = "/api/personal/send" if which == "personal" else "/api/others/send"
        return api_call(profile, "POST", path, body={"to": number, "message": text})

    try:
        result = send_via(route)
    except WppError as exc:
        # Auto-routing guesses from a cached number list; correct it once rather
        # than making the caller work out which endpoint applied.
        retry = None
        if args.route == "auto" and route == "personal" and exc.code in ("NOT_PERSONAL_NUMBER", "MISSING_SCOPE"):
            retry = "others"
        elif args.route == "auto" and route == "others" and exc.code == "MISSING_SCOPE":
            retry = "personal"
        if not retry:
            raise
        result = send_via(retry)
        route = retry

    return ok({
        "sent": True,
        "to": jid,
        "display_name": resolved["display_name"],
        "route": route,
        "message_id": result.get("messageId"),
    })


# ─── Watching ──────────────────────────────────────────────────────────────


def do_watch(args, profile, pretty):
    params = {}
    if args.chat:
        params["jid"] = resolve_target(profile, args.chat)["jid"]
    if args.type:
        params["type"] = args.type

    req, context, _url = build_request(
        profile, "GET", "/api/events", params, accept="text/event-stream"
    )
    try:
        stream = request.urlopen(req, timeout=None, context=context)
    except error.HTTPError as exc:
        raw = exc.read().decode("utf-8", errors="replace")
        try:
            server = json.loads(raw)
            raise WppError(server.get("error", "HTTP %s" % exc.code), server.get("code", "HTTP_ERROR"), exc.code)
        except ValueError:
            raise WppError("Server returned HTTP %s" % exc.code, "HTTP_ERROR", exc.code)
    except error.URLError as exc:
        raise WppError("Could not reach %s: %s" % (profile["url"], exc.reason), "CONNECTION_FAILED")

    count = 0
    with stream:
        for line in stream:
            line = line.decode("utf-8", errors="replace").rstrip("\n")
            if not line.startswith("data: "):
                continue
            try:
                event = json.loads(line[6:])
            except ValueError:
                continue
            emit(ok(event["data"], meta={"event": event["event"]}), pretty=pretty)
            if event["event"] == "message.new":
                count += 1
                if args.count and count >= args.count:
                    break
    return None


# ─── Read commands ─────────────────────────────────────────────────────────


def run_api_command(args, profile, pretty):
    command = args.command

    if command == "health":
        return ok(api_call(profile, "GET", "/api/health", auth=False))

    if command == "auth":
        return ok(api_call(profile, "GET", "/api/auth/test"))

    if command == "brief":
        data = api_call(profile, "GET", "/api/brief", {
            "limit": args.count,
            "messages": args.messages,
            "since": args.since,
            "groups": bool_text(not args.dms_only),
            "muted": bool_text(args.include_muted),
        })
        return ok(data, meta={"source_calls": 1})

    if command == "read":
        resolved = resolve_target(profile, args.target)
        result = api_call(
            profile, "POST",
            "/api/channels/%s/read" % parse.quote(resolved["jid"], safe=""),
            body={"up_to": args.up_to} if args.up_to else {},
        )
        return ok({"chat": resolved, **result})

    if command == "chats":
        chats = api_call(profile, "GET", "/api/channels", {
            "type": args.type if args.type != "all" else None,
            "search": args.search,
            "limit": args.count,
            "archived": bool_text(False) if args.no_archived else None,
        })
        if not args.verbose:
            chats = [compact_chat(c) for c in chats]
        return ok({"chats": chats}, meta={"count": len(chats)})

    if command == "groups":
        if args.live:
            groups = api_call(profile, "GET", "/api/groups", {"search": args.search})
        else:
            groups = api_call(profile, "GET", "/api/channels", {"type": "group", "search": args.search})
        return ok({"groups": groups}, meta={"count": len(groups), "source": "whatsapp" if args.live else "mirror"})

    if command == "chat":
        resolved = resolve_target(profile, args.target)
        info = api_call(profile, "GET", "/api/channels/%s" % parse.quote(resolved["jid"], safe=""))
        return ok(info, meta={"resolved": resolved})

    if command == "resolve":
        return ok(resolve_target(profile, args.target, kind=args.type))

    if command == "history":
        resolved = resolve_target(profile, args.target)
        messages = api_call(
            profile, "GET",
            "/api/channels/%s/messages" % parse.quote(resolved["jid"], safe=""),
            {"limit": args.count, "after": args.after, "before": args.before, "type": args.type},
        )
        messages.reverse()  # oldest first reads like a transcript
        count = len(messages)
        if not args.verbose:
            messages = [compact_message(m) for m in messages]
        if args.mark_read:
            api_call(profile, "POST", "/api/channels/%s/read" % parse.quote(resolved["jid"], safe=""), body={})
        return ok({"chat": resolved, "messages": messages}, meta={"count": count})

    if command == "search":
        jid = resolve_target(profile, args.chat)["jid"] if args.chat else None
        messages = api_call(profile, "GET", "/api/messages/search", {
            "q": args.query, "limit": args.count, "jid": jid, "type": args.type,
        })
        count = len(messages)
        if not args.verbose:
            messages = [
                {**compact_message(m), "chat": m.get("channel_name") or m.get("jid")}
                for m in messages
            ]
        return ok({"messages": messages}, meta={"count": count})

    if command == "whitelist":
        if args.whitelist_action == "list":
            entries = api_call(profile, "GET", "/api/whitelist")
            return ok({"whitelist": entries}, meta={"count": len(entries)})
        if args.whitelist_action == "add":
            entry = api_call(profile, "POST", "/api/whitelist",
                             body={"jid": args.target, "label": args.label})
            return ok(entry)
        if args.whitelist_action == "remove":
            entries = api_call(profile, "GET", "/api/whitelist")
            wanted = args.target if "@" in args.target else (phone_to_jid(args.target) or args.target)
            match = next((e for e in entries if e["jid"] == wanted), None)
            if not match:
                raise WppError("%s is not on the whitelist" % args.target, "NOT_FOUND")
            require_confirmation(args, "Remove %s from the whitelist?" % (match.get("label") or match["jid"]))
            api_call(profile, "DELETE", "/api/whitelist/%s" % parse.quote(match["id"], safe=""))
            return ok({"removed": match})
        raise WppError("Unknown whitelist action", "BAD_COMMAND")

    if command == "send":
        return do_send(args, profile)

    if command == "watch":
        return do_watch(args, profile, pretty)

    if command == "request":
        method = args.method.upper()
        body = None
        if args.data_stdin:
            raw = sys.stdin.read()
            body = json.loads(raw) if raw.strip() else None
        elif args.data:
            body = json.loads(args.data)
        if method not in ("GET", "HEAD"):
            require_confirmation(args, "%s %s?" % (method, args.path))
        return ok(api_call(profile, method, args.path, body=body))

    raise WppError("Unknown command: %s" % command, "BAD_COMMAND")


# ─── Parser ────────────────────────────────────────────────────────────────


def bounded_int(minimum, maximum):
    def parse_value(value):
        try:
            number = int(value)
        except ValueError:
            raise argparse.ArgumentTypeError("must be an integer")
        if number < minimum or number > maximum:
            raise argparse.ArgumentTypeError("must be between %s and %s" % (minimum, maximum))
        return number
    return parse_value


def build_parser():
    parser = argparse.ArgumentParser(
        prog="wpp",
        description="Agent-friendly CLI for a self-hosted WhatsApp Personal Proxy",
        epilog="Tokens are created and revoked in the web console under API Keys. "
               "JSON goes to stdout, errors to stderr, exit code is nonzero on failure.",
    )
    parser.add_argument("--version", action="version", version="wpp %s" % VERSION)
    parser.add_argument("--profile", help="Connection profile (or WPP_PROFILE)")
    parser.add_argument("--pretty", action="store_true", help="Pretty-print JSON")

    # The same two flags on every subcommand, so `wpp status --pretty` works as
    # well as `wpp --pretty status`. SUPPRESS keeps a subcommand default from
    # overwriting a value already given before the subcommand.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--profile", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--pretty", action="store_true", default=argparse.SUPPRESS,
                        help="Pretty-print JSON")

    sub = parser.add_subparsers(dest="command", required=True, parser_class=argparse.ArgumentParser)
    _add_parser = sub.add_parser

    def add_parser(name, **kwargs):
        kwargs.setdefault("parents", []).append(common)
        return _add_parser(name, **kwargs)

    sub.add_parser = add_parser

    p = sub.add_parser("connect", help="Test and securely save a server connection")
    p.add_argument("url", help="Server root, e.g. http://100.100.50.3:3300")
    p.add_argument("--name", default="default", help="Profile name (default: default)")
    p.add_argument("--token-stdin", action="store_true", help="Read the API token from the first stdin line")
    p.add_argument("--insecure", action="store_true", help="Allow a self-signed HTTPS certificate")
    p.add_argument("--timeout", type=int, default=30)

